# Dependencies
node_modules/

# Environment secrets
.env

# Build artifacts
dist/
build/

# Secure vault - encrypted files are committed by user choice, NOT auto-committed
# Remove the next line if you want to track encrypted vault files in git
secure_vault/*
!secure_vault/.gitkeep

# Logs (encrypted)
logs/*
!logs/.gitkeep

# TLS certificates (generate locally)
certs/*.key
certs/*.crt
certs/*.pem
certs/*.p12

# Runtime files
*.pid
*.sock

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
